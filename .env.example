# Copia este archivo como .env y pon tus propios valores:
#   cp .env.example .env
# .env está en .gitignore: NUNCA lo subas a GitHub.

# --- Docker (los lee docker-compose.yml) ---
DB_CONTRASENIA=cambia_esta_contrasena
PGADMIN_CONTRASENIA=cambia_esta_contrasena

# --- Java (los lee BaseDatos.java) ---
# El contenedor expone PostgreSQL en el puerto 5433 y la base se llama "admin".
DB_URL=jdbc:postgresql://localhost:5433/admin
DB_USER=admin
# Debe ser la misma que DB_CONTRASENIA.
DB_PASSWORD=cambia_esta_contrasena
